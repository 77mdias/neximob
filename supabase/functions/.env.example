# Variáveis das Edge Functions do Neximob.
#
# Local: copie para supabase/functions/.env (fora do Git) e rode
#   supabase functions serve --env-file supabase/functions/.env
# Testes e produção: cadastre no projeto com
#   supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já vêm do próprio Supabase.

# Segredo que o Supabase Cron manda para enviar-lembretes e alerta-rotina.
# Use um valor aleatório e longo, igual ao segredo "neximob_segredo_cron" do Vault.
NEXIMOB_SEGREDO_CRON=troque-por-um-valor-aleatorio-longo

# Resend (ADR-0007): chave só de envio e segredo de assinatura dos avisos.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Endereço de onde saem os lembretes, no domínio autenticado do Neximob.
NEXIMOB_EMAIL_REMETENTE=lembretes@mail.exemplo.com.br

# Quem recebe o alerta quando a rotina diária falha.
NEXIMOB_EMAIL_ALERTA=alertas@exemplo.com.br

# Origens do app que podem chamar excluir-conta pelo navegador (separadas por vírgula).
NEXIMOB_ORIGENS_PERMITIDAS=http://127.0.0.1:3000
